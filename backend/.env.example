# App
APP_NAME="Health Analyzer"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./health_analyzer.db

# Anthropic Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Whoop
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://localhost:8000/api/integrations/whoop/callback

# Withings
WITHINGS_CLIENT_ID=your-withings-client-id
WITHINGS_CLIENT_SECRET=your-withings-client-secret
WITHINGS_REDIRECT_URI=http://localhost:8000/api/integrations/withings/callback

# Fitbod
FITBOD_CLIENT_ID=your-fitbod-client-id
FITBOD_CLIENT_SECRET=your-fitbod-client-secret
FITBOD_REDIRECT_URI=http://localhost:8000/api/integrations/fitbod/callback

# Yazio
YAZIO_CLIENT_ID=your-yazio-client-id
YAZIO_CLIENT_SECRET=your-yazio-client-secret
YAZIO_REDIRECT_URI=http://localhost:8000/api/integrations/yazio/callback

# Renpho (uses email/password auth as no official OAuth)
RENPHO_API_BASE=https://renpho.com/api

# Braun HealthKit (via Apple HealthKit bridge or direct)
BRAUN_API_KEY=your-braun-api-key

# Larq
LARQ_CLIENT_ID=your-larq-client-id
LARQ_CLIENT_SECRET=your-larq-client-secret
LARQ_REDIRECT_URI=http://localhost:8000/api/integrations/larq/callback

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
